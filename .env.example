# ============================================================
# 复制为 .env 后填写。.env 已在 .gitignore 中，严禁提交。
# 本文件只放占位符，禁止填写任何真实密钥。
# ============================================================

APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# JWT 密钥：留空则首次启动自动生成并写入 data/.secret
SECRET_KEY=
JWT_EXPIRE_MINUTES=120

# 初始管理员口令：留空则首次建库生成一次性随机口令（打印在日志里）
# 禁止填写 admin123 之类弱口令
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 大模型（留空则系统进入"检索式作答"降级模式，仍可完整演示）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 检索参数（阈值请用 `python -m acm_coach.cli calibrate` 实测标定后再改）
ENABLE_VECTOR=true
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_TEXT_MODE=content_only
TOP_K=6
RECALL_K=24
RRF_K=60
BM25_K1=1.5
BM25_B=0.75
ENABLE_RERANK=true
RERANK_TOP_N=24
STRONG_THRESHOLD=0.45
WEAK_THRESHOLD=0.32
TYPE_BOOST=true

# 爬虫（只访问公开 API，限速 1 req/s）
CRAWLER_QPS=1.0
CRAWLER_TIMEOUT=30
CRAWLER_RETRIES=3
