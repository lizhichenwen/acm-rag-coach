# ============================================================
# 复制为 .env 后填写。.env 已在 .gitignore 中，严禁提交。
# 本文件只放占位符，禁止填写任何真实密钥。
# ============================================================

APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# JWT 密钥：留空则首次启动自动生成并写入 data/.secret
SECRET_KEY=
JWT_EXPIRE_MINUTES=120

# 初始管理员口令：留空则首次建库生成一次性随机口令（打印在日志里）
# 禁止填写 admin123 之类弱口令
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 大模型（留空则系统进入"检索式作答"降级模式，仍可完整演示）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 检索参数（阈值请用 `python -m acm_coach.cli calibrate` 实测标定后再改）
ENABLE_VECTOR=true
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_TEXT_MODE=content_only
TOP_K=6
RECALL_K=24
RRF_K=60
BM25_K1=1.5
BM25_B=0.75
# 重排（cross-encoder）：模型需预先下载到本地缓存，否则自动降级为融合打分。
# 推荐在部署阶段预下载：HF_ENDPOINT=https://hf-mirror.com python -c \
#   "from sentence_transformers import CrossEncoder; CrossEncoder('BAAI/bge-reranker-base')"
# RERANK_DOWNLOAD=true 允许运行时联网拉取（首次启动会慢，生产建议 false）。
ENABLE_RERANK=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DOWNLOAD=false
RERANK_TOP_N=24
# 送进 cross-encoder 的文档字符数；真正的开销是 token 数，语料 p99≈423 字符
RERANK_DOC_CHARS=1200
# 以下三项是 2026-11-21 延迟优化（实测冷启动 4.1s→2.85s，重复问 14ms）
RERANK_MAX_LENGTH=192
RERANK_BATCH_SIZE=16
RERANK_CACHE_SIZE=256
# 后台预热：healthz 秒起，索引/模型在 daemon 线程里加载；首个请求会等待预热完成
# WARMUP_RERANKER=true 让首条对话不再等 3s 重排模型加载（代价：常驻 ~1.2GB 内存）
WARMUP_RERANKER=true
STRONG_THRESHOLD=0.45
WEAK_THRESHOLD=0.32
TYPE_BOOST=true

# 爬虫（只访问公开 API，限速 1 req/s）
CRAWLER_QPS=1.0
CRAWLER_TIMEOUT=30
CRAWLER_RETRIES=3
